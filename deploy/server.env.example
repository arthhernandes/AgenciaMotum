# Configure no painel da aplicação Node.js na Hostinger. Não envie valores reais ao Git.
NODE_ENV=production
SERVE_FRONTEND=true
# PORT é fornecida pela Hostinger; não defina manualmente.
FRONTEND_URL=https://escola.agenciamotum.com.br
CORS_ORIGINS=https://escola.agenciamotum.com.br

# Supabase: copie os hosts exatos em Connect e codifique a senha na URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require
DIRECT_URL=postgresql://postgres.PROJECT_REF:SENHA@POOLER_HOST:5432/postgres?sslmode=require
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO

BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=https://escola.agenciamotum.com.br/api/bling/auth/callback
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://escola.agenciamotum.com.br/api/mercadolivre/auth/callback

# Usadas somente no seed inicial; depois podem ser removidas do painel.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
MASTER_ADMIN_NAME=Administrador master

# Opcional, para o assistente. Um Ollama em localhost não é acessível da Hostinger.
CHAT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
