# Copie as URLs do painel Connect do Supabase. Use senha com caracteres percent-encoded.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
# Conexão direta (IPv6) ou session pooler na porta 5432 para migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@POOLER_HOST:5432/postgres?sslmode=require"
JWT_SECRET=change-me
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Opcional: execução independente de scripts/order-profitability.cjs (não usado na seleção de conta do app).
ACCESS_TOKEN=
SELLER_ID=
# General tax percentage for the profitability CLI (0 to 100; explicitly required).
GENERAL_TAX_RATE=
MELI_REDIRECT_URI=http://localhost:3001/api/mercadolivre/auth/callback
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=http://localhost:3001/api/bling/auth/callback
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
MASTER_ADMIN_NAME=Administrador master
API_PORT=3001
# A Hostinger fornece PORT; não sobrescreva essa variável no hPanel.
# npm start serve frontend e backend juntos. Desenvolvimento permanece separado.
# SERVE_FRONTEND=true
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
CHAT_PROVIDER=openai
# Para Qwen: CHAT_PROVIDER=qwen e URL base do servidor compatível (ex.: http://servidor:11434/v1)
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=
FRONTEND_PORT=4200
FRONTEND_URL=http://localhost:4200

# Optional explicit frontend origins, separated by commas.
CORS_ORIGINS=
